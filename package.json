{
  "name": "seisan-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:api": "node scripts/with-server.mjs npx vitest run tests/api",
    "test:e2e": "node scripts/with-server.mjs npx playwright test",
    "test:health": "node scripts/health-check.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "nanoid": "^5.0.9",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
